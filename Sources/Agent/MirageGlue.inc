    id previous = _current;
    id current = format ? (__bridge id)buffer : nil;
    BOOL consecutive = ready && current && now - _lastCapture <= historyLimit &&
        matchingInput(previous, buffer, format);
    _current = current;
    _lastCapture = now;
    _present = nil;
    _realShown = NO;
    _predictionShown = NO;
    _repeat = repeat && consecutive;
    if (!consecutive) _held = nil;

    // Only reuse a precomputed frame when native presentation selected the same two inputs.
    if (consecutive && _ahead.current == current && _ahead.previous == previous) {
        _present = _ahead;
    } else if (current && !_running && (consecutive || !_available)) {
        _present = [self schedule:current after:consecutive ? previous : nil format:format early:NO];
    }
    _ahead = nil;
    [_state unlock];
}

- (CVPixelBufferRef)copyInterpolatedFrame {

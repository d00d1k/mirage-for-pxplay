static BOOL matchingInput(id previous, CVPixelBufferRef current, OSType format) {
    CVPixelBufferRef prior = (__bridge CVPixelBufferRef)previous;
    return prior && format && CVPixelBufferGetWidth(prior) == CVPixelBufferGetWidth(current) &&
        CVPixelBufferGetHeight(prior) == CVPixelBufferGetHeight(current) &&
        CVPixelBufferGetPixelFormatType(prior) == format;
}

// A stream frame that repeats the previous one (the game held its frame, so the console
// sent the same picture again) changes only in small places: encoder noise, HUD effects
// the game animates at 60 Hz (damage vignette, blinking icons). Compared as mean luma per
// 64x64 block on a sparse 8 px grid: a repeat has at most 1 in 20 blocks off by more than
// 4. Calibrated on PS5 GTA VI captures (clip-check.m): after a visible prediction this
// catches 27 of 37 repeats and took none of 2439 new frames for one.
static const int kRepeatBlockLimit = 4;
static BOOL repeatsFrame(CVPixelBufferRef a, CVPixelBufferRef b) {
    if (!a || !b) return NO;
    if (a == b) return YES;
    size_t w = CVPixelBufferGetWidth(b), h = CVPixelBufferGetHeight(b);
    if (CVPixelBufferGetWidth(a) != w || CVPixelBufferGetHeight(a) != h ||
        !CVPixelBufferIsPlanar(a) || !CVPixelBufferIsPlanar(b)) return NO;
    if (CVPixelBufferLockBaseAddress(a, kCVPixelBufferLock_ReadOnly) != kCVReturnSuccess) return NO;
    if (CVPixelBufferLockBaseAddress(b, kCVPixelBufferLock_ReadOnly) != kCVReturnSuccess) {
        CVPixelBufferUnlockBaseAddress(a, kCVPixelBufferLock_ReadOnly);
        return NO;
    }
    const uint8_t *p = CVPixelBufferGetBaseAddressOfPlane(a, 0), *q = CVPixelBufferGetBaseAddressOfPlane(b, 0);
    size_t ps = CVPixelBufferGetBytesPerRowOfPlane(a, 0), qs = CVPixelBufferGetBytesPerRowOfPlane(b, 0);
    size_t allowed = (w / 64) * (h / 64) / 20, changed = 0;
    BOOL same = p && q;
    for (size_t by = 0; same && by + 64 <= h; by += 64) {
        for (size_t bx = 0; same && bx + 64 <= w; bx += 64) {
            int sum = 0;
            for (size_t y = by + 4; y < by + 64; y += 8) {
                for (size_t x = bx + 4; x < bx + 64; x += 8) sum += abs((int)p[y * ps + x] - (int)q[y * qs + x]);
            }
            if (sum > 64 * kRepeatBlockLimit && ++changed > allowed) same = NO;
        }
    }
    CVPixelBufferUnlockBaseAddress(b, kCVPixelBufferLock_ReadOnly);
    CVPixelBufferUnlockBaseAddress(a, kCVPixelBufferLock_ReadOnly);
    return same;
}


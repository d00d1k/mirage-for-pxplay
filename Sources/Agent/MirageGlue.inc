- (LabFramePair *)schedule:(id)current after:(id)previous format:(OSType)format early:(BOOL)early {
    LabFramePair *pair = [[LabFramePair alloc] init];
    pair.current = current;
    pair.previous = previous;
    pair.prefetched = early;
    _running = pair;
    dispatch_async(_worker, ^{
        @autoreleasepool {
            CVPixelBufferRef next = (__bridge CVPixelBufferRef)pair.current;
            int width = (int)CVPixelBufferGetWidth(next), height = (int)CVPixelBufferGetHeight(next);
            if (!self->_backend || self->_backendFormat != format || self->_backendWidth != width ||
                self->_backendHeight != height) {
                if (self->_backend) FGLabBackendDestroy(self->_backend);
                self->_backend = FGLabBackendCreate(self->_engine, self->_profile, width, height,
                    format, self->_protectHud ? 1 : 0, fgResourcesPath.fileSystemRepresentation);
                self->_backendLastFrame = nil;
                self->_backendFormat = format;
                self->_backendWidth = width;
                self->_backendHeight = height;
                if (self->_backend && self->_extrapolating) FGLabBackendSetExtrapolation(self->_backend, 0.5f);
                if (self->_backend) fprintf(stderr, "[Mirage] %s ready for %dx%d.\n",
                    self->_name.UTF8String, width, height);
            }
            CVPixelBufferRef generated = NULL;
            if (self->_backend && pair.previous) {
                // A queued frame can be skipped by PXPlay. Reset RIFE's cache whenever the
                // previous frame selected for the new pair differs from the last backend input.
                self->_backendSequence += self->_backendLastFrame == pair.previous ? 1 : 2;
                float step = 0;
                if (self->_extrapolating) {
                    step = 0.5f * (float)atomic_load(&extrapStrength) / 100.0f * stickGain();
                    FGLabBackendSetExtrapolationTuning(self->_backend, step, atomic_load(&extrapDamping));
                }
                generated = FGLabBackendRender(self->_backend, (__bridge CVPixelBufferRef)pair.previous,
                    next, self->_backendSequence);
                self->_backendLastFrame = generated ? pair.current : nil;
                if (generated && step > 0) {
                    float info[6] = {0};

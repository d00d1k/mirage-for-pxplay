    if (!_closed && (__bridge id)buffer != _held) {
        _held = (__bridge id)buffer;
        _heldSince = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
        _heldShift = _handedShift;
    }
    [_state unlock];
}

- (void)dropHeld {
    [_state lock];
    _held = nil;
    [_state unlock];

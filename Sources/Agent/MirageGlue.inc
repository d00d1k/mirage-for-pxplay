// repeatOnly: only for a segment whose source frame repeats the previous one. Otherwise:
// whenever the prediction is still the newest picture shown (no new frame arrived).
// Game hitches last 50-100 ms; past kHoldLimit (a pause, a frozen stream) the real frame
// goes back on screen so a prediction never sits there for long.
static const uint64_t kHoldLimit = 120 * NSEC_PER_MSEC;
- (CVPixelBufferRef)copyHeldFrame:(BOOL)repeatOnly {
    [_state lock];
    CVPixelBufferRef frame = NULL;
    uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
    if (!_closed && _held && (!repeatOnly || _repeat) && now - _heldSince <= kHoldLimit) {
        frame = CVPixelBufferRetain((__bridge CVPixelBufferRef)_held);
        if (++_heldCount == 1 || _heldCount % 60 == 0) {
            fprintf(stderr, "[Mirage] %s: held the prediction over %lu repeated/late frames.\n",
                    _name.UTF8String, (unsigned long)_heldCount);
        }
    }
    [_state unlock];
    return frame;
}

- (BOOL)takePredictionSlot {
    [_state lock];
    BOOL free = _realShown && !_predictionShown;
    _predictionShown = YES;
    [_state unlock];
    return free;
}

- (void)recordGeneratedFrame {
    [_state lock];
    _lastGenerated = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
    ++_windowGenerated;
    if (++_generatedCount == 1 || _generatedCount % 120 == 0) {
        fprintf(stderr, "[Mirage] %s: %lu generated, %lu PXPlay fallback, %lu started early, "
                        "FG wait %.2f ms average.\n",
                _name.UTF8String, (unsigned long)_generatedCount, (unsigned long)_fallbackCount,
                (unsigned long)_prefetchedCount, (double)_renderWaitTotal / _generatedCount / 1e6);
    }
    [_state unlock];
}

- (void)recordFallback {
    if (_engine == FGLabStock) return;
    [_state lock];
    ++_fallbackCount;
    ++_windowFallback;
    _lastFallback = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
    [_state unlock];
}

- (NSString *)generationStatus {
    if (_engine == FGLabStock) return @"FG: PXPlay";
    [_state lock];
    uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
    NSString *status = @"FG: PXPlay";
    if (now - _windowStart >= NSEC_PER_SEC) {
        unsigned total = _windowGenerated + _windowFallback;
        _share = total ? (int)lround(100.0 * _windowGenerated / total) : -1;
        _windowGenerated = _windowFallback = 0;
        _windowStart = now;
    }
    if (_lastGenerated && now - _lastGenerated <= NSEC_PER_SEC) {
        BOOL mixed = _lastFallback && now - _lastFallback <= NSEC_PER_SEC;
        if (mixed && _share >= 0 && _share < 100) {
            status = [NSString stringWithFormat:@"FG: %@ %d%%", _name, _share];
        } else {
            status = [NSString stringWithFormat:@"FG: %@%@", _name, mixed ? @"/PX" : @""];
        }
    }
    [_state unlock];
    return status;
}

- (void)close {
    if (_engine == FGLabStock) return;
    [_state lock];
    _closed = YES;
    _present = nil;
    _ahead = nil;
    _current = nil;
    _held = nil;
    [_state broadcast];
    [_state unlock];
    dispatch_async(_worker, ^{
        if (self->_backend) FGLabBackendDestroy(self->_backend);
        self->_backend = NULL;
        self->_backendLastFrame = nil;
    });
}

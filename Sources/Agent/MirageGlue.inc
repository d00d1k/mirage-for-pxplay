// Offsets are for the exact signed ARM64 renderer bundled with this edition.
// The scaler object is only tested for presence; the renderer owns it.
enum {
    metalFXScalerOffset = 0x90,
    metalFXRequestedOffset = 0x98,
    metalFXFactorOffset = 0xa0
};

static NSString *scaleStatus(jlong handle) {
    [registryLock lock];
    NSString *status = nil;
    if ([activeRenderers containsObject:@(handle)]) {
        const uint8_t *renderer = (const uint8_t *)(uintptr_t)handle;
        BOOL requested = renderer[metalFXRequestedOffset] != 0;
        uintptr_t scaler = __atomic_load_n((const uintptr_t *)(renderer + metalFXScalerOffset), __ATOMIC_RELAXED);
        double factor;
        memcpy(&factor, renderer + metalFXFactorOffset, sizeof(factor));
        if (!requested) {
            status = @"Scale: Off";
        } else if (!scaler) {
            status = @"Scale: Standard";
        } else if (isfinite(factor) && factor > 1) {
            status = [NSString stringWithFormat:@"Scale: MetalFX Spatial ×%g", factor];
        } else {
            status = @"Scale: MetalFX Spatial";
        }
    }
    [registryLock unlock];
    return status;
}

static jlong JNICALL initRenderer(JNIEnv *env, jobject self, jlong view, jint width, jint height,
    jboolean metalFX, jboolean hdr, jdouble scale, jint aspectMode, jfloat first, jfloat second,
    jboolean extra1, jboolean extra2) {
    jlong handle = atomic_load(&originalInit)(env, self, view, width, height, metalFX, hdr, scale,
        aspectMode, first, second, extra1, extra2);
    if (handle) {
        @autoreleasepool {
            [registryLock lock];
            [activeRenderers addObject:@(handle)];
            [registryLock unlock];
        }
    }
    return handle;
}

static NSString *compactOverlay(NSString *base, NSString *scale, NSString *generation) {
    NSArray<NSString *> *parts = [base componentsSeparatedByString:@" | "];
    NSString *resolution = parts.firstObject;
    if ([resolution hasSuffix:@" (MetalFX)"]) {
        resolution = [resolution substringToIndex:resolution.length - [@" (MetalFX)" length]];
    }
    NSString *shortScale = [scale stringByReplacingOccurrencesOfString:@"Scale: MetalFX Spatial" withString:@"MetalFX"];
    shortScale = [shortScale stringByReplacingOccurrencesOfString:@"Scale: Off" withString:@"Scale off"];
    shortScale = [shortScale stringByReplacingOccurrencesOfString:@"Scale: Standard" withString:@"Scale standard"];
    NSString *fgLabel = nil;
    NSMutableArray<NSString *> *stats = [NSMutableArray array];
    for (NSUInteger i = 1; i < parts.count; ++i) {
        NSString *item = parts[i];
        if ([item hasPrefix:@"FG "]) {
            if (!generation) {
                fgLabel = item;
                continue;
            }
            NSString *name = [generation hasPrefix:@"FG: "] ? [generation substringFromIndex:4] : generation;
            if ([name isEqualToString:@"Apple VideoToolbox"]) name = @"Apple FG";
            if ([name isEqualToString:@"PXPlay"]) name = @"PXPlay FG";
            NSRange separator = [item rangeOfString:@": "];
            if (separator.location != NSNotFound) {
                NSString *rates = [item substringFromIndex:NSMaxRange(separator)];
                rates = [rates stringByReplacingOccurrencesOfString:@" -> " withString:@"→"];
                rates = [rates stringByReplacingOccurrencesOfString:@" FPS" withString:@""];
                fgLabel = [NSString stringWithFormat:@"%@ %@", name, rates];
            } else {
                fgLabel = name;
            }
        } else {
            [stats addObject:[item stringByReplacingOccurrencesOfString:@": " withString:@" "]];
        }
    }
    NSMutableString *line = [NSMutableString stringWithFormat:@"%@ · %@", resolution, shortScale];
    if (fgLabel) [line appendFormat:@" · %@", fgLabel];
    if (stats.count) [line appendFormat:@" | %@", [stats componentsJoinedByString:@" · "]];
    return line;
}

static jstring overlayWithStatus(JNIEnv *env, jstring text, NSString *scale, NSString *generation) {
    jsize length = (*env)->GetStringLength(env, text);
    if (!length || length > 4096) return NULL;
    const jchar *chars = (*env)->GetStringChars(env, text, NULL);
    if (!chars) return NULL;
    NSString *base = [[NSString alloc] initWithCharacters:(const unichar *)chars length:(NSUInteger)length];
    (*env)->ReleaseStringChars(env, text, chars);
    NSString *extended = compactOverlay(base, scale, generation);
    NSUInteger count = extended.length;
    unichar merged[4160];
    if (count > sizeof(merged) / sizeof(merged[0])) return NULL;
    [extended getCharacters:merged range:NSMakeRange(0, count)];
    return (*env)->NewString(env, (const jchar *)merged, (jsize)count);
}

static void JNICALL setPerfOverlay(JNIEnv *env, jobject self, jlong renderer, jboolean visible,
    jboolean share, jstring text) {
    @autoreleasepool {
        jstring decorated = NULL;
        if (visible && text && renderer) {
            NSString *scale = scaleStatus(renderer);
            NSString *generation = [sessionFor(renderer, NO) generationStatus];
            if (scale) {
                [registryLock lock];
                lastScaleStatus = scale;
                lastGenerationStatus = generation ?: @"FG: Off";
                [registryLock unlock];
                decorated = overlayWithStatus(env, text, scale, generation);
            }
        }
        if (!(*env)->ExceptionCheck(env)) {
            atomic_load(&originalPerfOverlay)(env, self, renderer, visible, share, decorated ?: text);
        }
        if (decorated) (*env)->DeleteLocalRef(env, decorated);
    }
}

static id<FGSession> sessionFor(jlong renderer, BOOL create) {
    [registryLock lock];
    id<FGSession> session = sessions[@(renderer)];
    if (!session && create) {
        uint32_t selection = atomic_load(&fgSelection);
        FGLabEngine engine = selection & 0xff;
        int profile = (selection >> 8) & 0xff;
        int wait = (selection >> 16) & 0xff;
        session = [[AlternativeFGSession alloc] initWithEngine:engine profile:profile wait:wait];
        sessions[@(renderer)] = session;
    }
    [registryLock unlock];
    return session;
}

static void closeSession(jlong renderer) {
    [registryLock lock];
    id<FGSession> session = sessions[@(renderer)];
    [sessions removeObjectForKey:@(renderer)];
    [registryLock unlock];
    [session close];
}

static jboolean JNICALL setFG(JNIEnv *env, jobject self, jlong renderer, jboolean enabled) {
    jboolean okay = atomic_load(&originalSetFG)(env, self, renderer, enabled);
    @autoreleasepool {
        if (okay && enabled && renderer) sessionFor(renderer, YES);
        else closeSession(renderer);
    }
    return okay;
}

static jint JNICALL decode(JNIEnv *env, jobject self, jlong renderer, jlong buffer) {
    jint status = atomic_load(&originalDecode)(env, self, renderer, buffer);
    @autoreleasepool {
        if (status >= 0 && renderer && buffer) {
            [sessionFor(renderer, NO) capture:(CVPixelBufferRef)(uintptr_t)buffer ready:status > 0];
        }
    }
    return status;
}

static void cacheGenerationStatus(id<FGSession> session) {
    NSString *status = [session generationStatus];
    if (!status) return;
    [registryLock lock];
    lastGenerationStatus = status;
    [registryLock unlock];
}

static AlternativeFGSession *extrapolatingSession(jlong renderer) {
    id session = sessionFor(renderer, NO);
    if (![session isKindOfClass:AlternativeFGSession.class]) return nil;
    AlternativeFGSession *alternative = session;
    return alternative.extrapolating ? alternative : nil;
}

// Puts the held prediction back on screen (see AlternativeFGSession hold).
static BOOL presentHeld(JNIEnv *env, jobject self, jlong renderer, AlternativeFGSession *session, BOOL repeatOnly) {
    RenderFn render = atomic_load(&originalRender);
    if (!render) return NO;
    CVPixelBufferRef buffer = [session copyHeldFrame:repeatOnly];
    if (!buffer) return NO;
    render(env, self, renderer, (jlong)(uintptr_t)buffer);
    CVPixelBufferRelease(buffer);
    [session recordGeneratedFrame];
    cacheGenerationStatus(session);
    return YES;
}

// Shows the prediction for the current segment once. Returns NO when it is not ready.
// For a repeated source frame the held prediction stays instead (nothing new to predict).
static BOOL presentPrediction(JNIEnv *env, jobject self, jlong renderer, AlternativeFGSession *session) {
    RenderFn render = atomic_load(&originalRender);
    if (!render || ![session takePredictionSlot]) return NO;
    CVPixelBufferRef buffer = [session copyHeldFrame:YES];
    if (!buffer) buffer = [session copyInterpolatedFrame];
    if (!buffer) {
        [session recordFallback];
        return NO;
    }
    render(env, self, renderer, (jlong)(uintptr_t)buffer);
    [session presented:buffer];
    CVPixelBufferRelease(buffer);
    [session recordGeneratedFrame];
    cacheGenerationStatus(session);
    return YES;
}

static jboolean JNICALL presentLatest(JNIEnv *env, jobject self, jlong renderer) {
    @autoreleasepool {
        AlternativeFGSession *session = extrapolatingSession(renderer);
        if (session && [session realShown] && presentPrediction(env, self, renderer, session)) return JNI_TRUE;
        if (session) {
            CVPixelBufferRef real = [session takeRealFrame];
            if (real) CVPixelBufferRelease(real);
            // A repeated frame, or no new frame at all since the prediction went out: keep
            // the prediction rather than stepping back to the older real frame.
            if (presentHeld(env, self, renderer, session, real != NULL)) return JNI_TRUE;
            [session dropHeld];
        }
        return atomic_load(&originalPresentLatest)(env, self, renderer);
    }
}

static jboolean JNICALL interpolate(JNIEnv *env, jobject self, jlong renderer, jfloat phase) {
    @autoreleasepool {
        AlternativeFGSession *extrapolating = extrapolatingSession(renderer);
        RenderFn render = atomic_load(&originalRender);
        PresentLatestFn latest = atomic_load(&originalPresentLatest);
        if (extrapolating && render && latest && phase < 1.0f) {
            // Real frame first, through PXPlay's own path, without waiting for the next one.
            CVPixelBufferRef real = [extrapolating takeRealFrame];
            if (real) {
                CVPixelBufferRelease(real);
                if (presentHeld(env, self, renderer, extrapolating, YES)) return JNI_TRUE;
                [extrapolating dropHeld];
                return latest(env, self, renderer);
            }
            return presentPrediction(env, self, renderer, extrapolating) ? JNI_TRUE : JNI_FALSE;
        }
        id<FGSession> session = sessionFor(renderer, NO);
        if (session && render && fabsf(phase - 0.5f) < 0.0001f) {
            CVPixelBufferRef buffer = [session copyInterpolatedFrame];
            if (buffer) {
                render(env, self, renderer, (jlong)(uintptr_t)buffer);
                CVPixelBufferRelease(buffer);
                [session recordGeneratedFrame];
                cacheGenerationStatus(session);
                return JNI_TRUE;
            }
        }
        jboolean shown = atomic_load(&originalInterpolate)(env, self, renderer, phase);
        if (shown) {
            [session recordFallback];
            cacheGenerationStatus(session);
        }
        return shown;
    }
}

static void JNICALL dispose(JNIEnv *env, jobject self, jlong renderer) {
    @autoreleasepool {
        [registryLock lock];
        [activeRenderers removeObject:@(renderer)];
        [registryLock unlock];
        closeSession(renderer);
    }
    atomic_load(&originalDispose)(env, self, renderer);
}


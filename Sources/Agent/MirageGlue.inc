    CVPixelBufferRef buffer = NULL;
    if (!_closed && pair && _present == pair && pair.output) {
        buffer = CVPixelBufferRetain((__bridge CVPixelBufferRef)pair.output);
        _present = nil;
        _prefetchedCount += pair.prefetched;
        _handedShift = pair.shift;
        _renderWaitTotal += clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - start;
    }
    [_state unlock];
    return buffer;
}


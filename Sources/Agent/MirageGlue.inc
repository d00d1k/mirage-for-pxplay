// Camera stick events: the stick returning to centre, dropping to less than half its
// deflection, or flipping direction. The game stops or turns the camera shortly after.
static void reportStick(int rx, int ry) {
    static int scale = 127;
    static float lastX, lastY, lastMag;
    int peak = abs(rx) > abs(ry) ? abs(rx) : abs(ry);
    if (peak > 255) scale = 32767;
    float x = (float)rx / scale, y = (float)ry / scale;
    float mag = sqrtf(x * x + y * y);
    bool released = lastMag > 0.35f && mag < 0.2f;
    bool dropped = lastMag > 0.5f && mag < 0.5f * lastMag;
    bool reversed = lastMag > 0.35f && mag > 0.35f && (x * lastX + y * lastY) < -0.2f * mag * lastMag;
    if (released || dropped || reversed) atomic_store(&stickEventNs, clock_gettime_nsec_np(CLOCK_UPTIME_RAW));
    lastX = x; lastY = y; lastMag = mag;
}

// Prediction gain from the stick: zero while a release/reversal is reaching the video.
static float stickGain(void) {
    int delay = atomic_load(&extrapStickDelayMs);
    uint64_t event = atomic_load(&stickEventNs);
    if (delay < 0 || !event) return 1.0f;
    uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
    uint64_t start = event + (uint64_t)delay * NSEC_PER_MSEC;
    if (now >= start && now < start + stickHoldNs) {
        atomic_fetch_add(&stickSuppressed, 1);
        return 0.0f;
    }
    return 1.0f;
}

static OSType labInputFormat(CVPixelBufferRef buffer) {
    if (!buffer || !CVPixelBufferGetIOSurface(buffer)) return 0;
    size_t w = CVPixelBufferGetWidth(buffer), h = CVPixelBufferGetHeight(buffer);
    if (!((w == 1920 && h == 1080) || (w == 1280 && h == 720))) return 0;
    OSType format = CVPixelBufferGetPixelFormatType(buffer);
    if (format != kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange &&
        format != kCVPixelFormatType_420YpCbCr8BiPlanarFullRange) return 0;
    CFTypeRef transfer = CVBufferCopyAttachment(buffer, kCVImageBufferTransferFunctionKey, NULL);
    bool hdr = transfer && (CFEqual(transfer, kCVImageBufferTransferFunction_SMPTE_ST_2084_PQ) ||
        CFEqual(transfer, kCVImageBufferTransferFunction_ITU_R_2100_HLG));
    if (transfer) CFRelease(transfer);
    return hdr ? 0 : format;
}


    // source frame arrived: waiting past the tick pushes the real frame back a whole refresh.
    uint64_t wait = (uint64_t)_waitMilliseconds * NSEC_PER_MSEC;
    if (pair && _available && _running == pair && wait) {
        NSDate *deadline = [NSDate dateWithTimeIntervalSinceNow:(double)wait / 1e9];
        while (!_closed && _present == pair && _running == pair && [_state waitUntilDate:deadline]) {}

    [_state unlock];
}

- (void)capture:(CVPixelBufferRef)buffer ready:(BOOL)ready {
    if (_engine == FGLabStock) return;
    OSType format = labInputFormat(buffer);
    uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
    // The comparison reads both frames on the CPU, outside the lock the presenter takes.

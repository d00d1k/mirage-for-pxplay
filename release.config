# Release settings read by build.sh. Fill in the links before publishing.
# An empty link hides its button in the installer.
MIRAGE_VERSION="1.0.0"
# Support page shown as a button on the installer's last screen
MIRAGE_DONATE_URL="https://www.patreon.com/17168801/join"
# The GitHub repository page, for example https://github.com/yourname/mirage-for-pxplay
MIRAGE_PROJECT_URL="https://github.com/d00d1k/mirage-for-pxplay"
